[user]
    name = romanohu
    email = 158289679+romanohu@users.noreply.github.com
[core]
    excludesfile = ~/.config/git/ignore
    autocrlf = input
[init]
    defaultBranch = main
[pull]
    rebase = true
[fetch]
    prune = true
[rerere]
    enabled = true
[push]
    default = current
    autoSetupRemote = true
[alias]
    st = status
    cm = commit
[color]
    ui = auto
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
