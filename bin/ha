#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf '%s\n' 'Usage: ha [--dry-run] [COMMAND]' >&2
}

fail() {
    printf 'ha: %s\n' "$*" >&2
    exit 1
}

is_command_name() {
    [[ "$1" =~ ^[A-Za-z0-9._+-]+$ ]]
}

dry_run=false
requested_command=''
positional_seen=false

while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run)
            dry_run=true
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            usage
            fail "unknown option: $1"
            ;;
        *)
            if [ "$positional_seen" = true ]; then
                usage
                fail 'at most one command may be specified'
            fi
            requested_command="$1"
            positional_seen=true
            ;;
    esac
    shift
done

if [ "$positional_seen" = true ] && ! is_command_name "$requested_command"; then
    fail "invalid command name: $requested_command"
fi

config_path="${HA_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/agents.local}"
[ -f "$config_path" ] || fail "local command configuration not found: $config_path"

declare -a configured_commands=()
while IFS= read -r config_line || [ -n "$config_line" ]; do
    case "$config_line" in
        ''|'#'*)
            continue
            ;;
    esac

    if [[ "$config_line" =~ [[:space:]] ]]; then
        fail "local command configuration contains whitespace: $config_path"
    fi
    if ! is_command_name "$config_line"; then
        fail "invalid command name in local configuration: $config_line"
    fi
    configured_commands+=("$config_line")
done < "$config_path"

[ "${#configured_commands[@]}" -gt 0 ] || fail "local command configuration is empty: $config_path"

selected_command="$requested_command"
if [ -z "$selected_command" ]; then
    if command -v fzf >/dev/null 2>&1; then
        selected_command="$(printf '%s\n' "${configured_commands[@]}" | fzf)" || fail 'command selection cancelled'
        is_command_name "$selected_command" || fail 'command selection was invalid'
    else
        selected_command="${configured_commands[0]}"
    fi
fi

configured=false
for configured_command in "${configured_commands[@]}"; do
    if [ "$configured_command" = "$selected_command" ]; then
        configured=true
        break
    fi
done
"$configured" || fail "command is not listed in local configuration: $selected_command"

command -v -- "$selected_command" >/dev/null 2>&1 || fail "command is not available on PATH: $selected_command"
command -v herdr >/dev/null 2>&1 || fail 'herdr is not available on PATH'
command -v jq >/dev/null 2>&1 || fail 'jq is not available on PATH'

current_dir="$(pwd -P)"
workspace_id="${HERDR_WORKSPACE_ID:-}"
root_pane_id=''

if [ "$dry_run" = true ]; then
    printf 'command: %s\n' "$selected_command"
    printf 'config: %s\n' "$config_path"
    printf 'cwd: %s\n' "$current_dir"
    if [ -n "$workspace_id" ]; then
        printf 'plan: herdr pane list --workspace %s\n' "$workspace_id"
        printf 'plan: herdr pane split --current --direction right --no-focus\n'
    else
        printf 'plan: herdr workspace list\n'
        printf 'plan: herdr workspace create --cwd %s --label %s --no-focus\n' \
            "$current_dir" "$(basename "$current_dir")"
        printf 'plan: herdr pane list --workspace <workspace-id>\n'
        printf 'plan: herdr pane split <root-pane-id> --direction right --no-focus\n'
    fi
    printf 'plan: herdr pane run <new-pane-id> %s\n' "$selected_command"
    printf 'plan: herdr pane rename <new-pane-id> agent-N\n'
    exit 0
fi

if [ -z "$workspace_id" ]; then
    workspace_list="$(herdr workspace list)" || fail 'unable to list Herdr workspaces'
    if ! printf '%s' "$workspace_list" | jq -e '.result.workspaces | arrays' >/dev/null; then
        fail 'Herdr workspace list did not return a workspace array'
    fi
    matching_workspace="$(printf '%s' "$workspace_list" | jq -cr --arg cwd "$current_dir" \
        '[.result.workspaces[] | select(.cwd == $cwd)] | .[0] // empty')" || \
        fail 'unable to inspect Herdr workspaces'

    if [ -n "$matching_workspace" ]; then
        workspace_id="$(printf '%s' "$matching_workspace" | jq -er '.workspace_id')" || \
            fail 'matching Herdr workspace did not return a workspace ID'
    else
        workspace_create="$(herdr workspace create --cwd "$current_dir" --label "$(basename "$current_dir")" --no-focus)" || \
            fail 'unable to create Herdr workspace'
        workspace_id="$(printf '%s' "$workspace_create" | jq -er '.result.workspace.workspace_id')" || \
            fail 'Herdr workspace creation did not return a workspace ID'
        root_pane_id="$(printf '%s' "$workspace_create" | jq -er '.result.root_pane.pane_id')" || \
            fail 'Herdr workspace creation did not return a root pane ID'
    fi
fi

pane_list="$(herdr pane list --workspace "$workspace_id")" || fail 'unable to list Herdr panes'
if ! printf '%s' "$pane_list" | jq -e '.result.panes | arrays' >/dev/null; then
    fail 'Herdr pane list did not return a pane array'
fi

next_label="$(printf '%s' "$pane_list" | jq -er '
    [.result.panes[]?.label
     | select(type == "string" and test("^agent-[0-9]+$"))
     | capture("^agent-(?<number>[0-9]+)$").number
     | tonumber]
    | if length == 0 then "agent-1" else "agent-\(max + 1)" end')" || \
    fail 'unable to determine the next generic pane label'

if [ -n "${HERDR_PANE_ID:-}" ]; then
    split_result="$(herdr pane split --current --direction right --no-focus)" || fail 'unable to split the current Herdr pane'
else
    if [ -z "$root_pane_id" ]; then
        root_pane_id="$(printf '%s' "$pane_list" | jq -er '.result.panes[0].pane_id')" || \
            fail 'Herdr workspace has no pane to split'
    fi
    split_result="$(herdr pane split "$root_pane_id" --direction right --no-focus)" || \
        fail 'unable to split the Herdr workspace root pane'
fi

new_pane_id="$(printf '%s' "$split_result" | jq -er '.result.pane.pane_id')" || \
    fail 'Herdr pane split did not return a pane ID'

pane_run="$(herdr pane run "$new_pane_id" "$selected_command")" || \
    fail 'unable to run command in the new Herdr pane'
if ! printf '%s' "$pane_run" | jq -e 'type == "object" and has("result")' >/dev/null; then
    fail 'Herdr pane run did not return a successful JSON response'
fi

pane_rename="$(herdr pane rename "$new_pane_id" "$next_label")" || \
    fail 'unable to rename the new Herdr pane'
if ! printf '%s' "$pane_rename" | jq -e 'type == "object" and has("result")' >/dev/null; then
    fail 'Herdr pane rename did not return a successful JSON response'
fi
